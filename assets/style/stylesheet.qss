/* A simple, modern-looking stylesheet for the OBD-II Diagnostic Tool */

QMainWindow {
    background-color: #2d2d2d;
}

QGroupBox {
    background-color: #3c3c3c;
    border: 1px solid #555;
    border-radius: 5px;
    margin-top: 1ex; /* space above the title */
    font-weight: bold;
    color: #e0e0e0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center; /* position at the top center */
    padding: 0 3px;
    background-color: #3c3c3c;
}

QLabel {
    color: #e0e0e0;
    font-size: 10pt;
}

QPushButton {
    background-color: #555;
    color: #e0e0e0;
    border: 1px solid #666;
    padding: 5px 10px;
    border-radius: 3px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #666;
    border-color: #777;
}

QPushButton:pressed {
    background-color: #444;
}

QLineEdit, QComboBox {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border: 1px solid #555;
    border-radius: 3px;
    padding: 4px;
}

QComboBox::drop-down {
    border: none;
}

QTextEdit, QTableView {
    background-color: #252525;
    color: #e0e0e0;
    border: 1px solid #555;
}

QHeaderView::section {
    background-color: #3c3c3c;
    color: #e0e0e0;
    padding: 4px;
    border: 1px solid #555;
}

QScrollBar:vertical {
    border: 1px solid #555;
    background: #2d2d2d;
    width: 15px;
    margin: 15px 0 15px 0;
}

QScrollBar::handle:vertical {
    background: #555;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
